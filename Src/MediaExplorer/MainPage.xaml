<Page
    x:Class="WEBVIEW.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WEBVIEW"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Button style for bottom bar -->
        <Style x:Key="BarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#3D3D3D"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#4D4D4D"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Root" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Omnibox Style -->
        <Style x:Key="BarOmniboxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="Padding" Value="10,4,10,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionHighlightColor" Value="#FF0078D7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BorderElement" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <TextBlock x:Name="PlaceholderTextContentPresenter" Text="{TemplateBinding PlaceholderText}" Foreground="#666666" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="ContentElement" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" IsTabStop="False" ZoomMode="Disabled"/>
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#555555"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF0078D7"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hub Menu Item Style -->
        <Style x:Key="HubMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#3D3D3D"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#4D4D4D"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid x:Name="RootGrid" Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="0" x:Name="DevToolsRow"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== DevTools Panel (top third, toggleable) ===== -->
        <Grid Grid.Row="0" x:Name="DevToolsPanel" Background="#1A1A1A" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- DevTools tab bar + close -->
            <Border Grid.Row="0" Background="#2D2D2D" BorderBrush="#3E3E3E" BorderThickness="0,0,0,1" Padding="4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tabs -->
                    <Button Grid.Column="0" x:Name="DevConsoleTab" Content="Console" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" FontSize="12" Padding="8,4" Click="DevConsoleTab_Click"/>
                    <Button Grid.Column="1" x:Name="DevDomTab" Content="DOM" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="12" Padding="8,4" Click="DevDomTab_Click"/>
                    <Button Grid.Column="2" x:Name="DevNetworkTab" Content="Network" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="12" Padding="8,4" Click="DevNetworkTab_Click"/>
                    <Button Grid.Column="3" x:Name="DevDebugTab" Content="Debug" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="12" Padding="8,4" Click="DevDebugTab_Click"/>

                    <!-- DevTools close -->
                    <Button Grid.Column="5" x:Name="DevToolsClose" Content="✕" Background="Transparent" Foreground="#FF6666" BorderThickness="0" FontSize="14" Padding="8,4" Click="DevToolsClose_Click"/>
                </Grid>
            </Border>

            <!-- Console tab content -->
            <Grid Grid.Row="1" x:Name="DevConsoleContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Console output -->
                <ScrollViewer Grid.Row="0" x:Name="DevConsoleOutput" VerticalScrollBarVisibility="Auto" Padding="8,4" Background="#111111">
                    <RichTextBlock x:Name="DevConsoleText" Foreground="#00FF00" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"/>
                </ScrollViewer>

                <!-- Console input -->
                <Grid Grid.Row="1" Background="#2D2D2D" BorderBrush="#3E3E3E" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="DevConsoleInput" PlaceholderText="> Enter JS..." Foreground="White" Background="#1A1A1A" BorderBrush="#3E3E3E" BorderThickness="1" FontFamily="Consolas" FontSize="12" Margin="4,2"/>
                    <Button Grid.Column="1" x:Name="DevConsoleRun" Content="▶" Background="#333333" Foreground="#00FF00" BorderThickness="1" BorderBrush="#555555" Margin="2" Click="DevConsoleRun_Click"/>
                </Grid>
            </Grid>

            <!-- DOM tab content -->
            <ScrollViewer Grid.Row="1" x:Name="DevDomContent" Visibility="Collapsed" Padding="8,4" Background="#111111">
                <TextBox x:Name="DevDomText" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
            </ScrollViewer>

            <!-- Network tab content -->
            <ScrollViewer Grid.Row="1" x:Name="DevNetworkContent" Visibility="Collapsed" Padding="8,4" Background="#111111">
                <TextBox x:Name="DevNetworkText" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
            </ScrollViewer>

            <!-- Debug tab content -->
            <ScrollViewer Grid.Row="1" x:Name="DevDebugContent" Visibility="Collapsed" Padding="8,4" Background="#111111">
                <TextBox x:Name="DevDebugText" Foreground="#FFA500" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
            </ScrollViewer>
        </Grid>

        <!-- ===== Content Area ===== -->
        <Grid Grid.Row="1" x:Name="ContentArea" Background="White" ManipulationMode="TranslateX">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CacheMode="{x:Null}">
                <StackPanel x:Name="ContentHost"/>
            </ScrollViewer>
        </Grid>

        <!-- ===== Loading Progress Bar (Chrome-style top indicator) ===== -->
        <Border x:Name="LoadProgressBar" Grid.Row="1" Height="3"
                VerticalAlignment="Top" Background="#FF0078D7"
                HorizontalAlignment="Left" Width="0" Visibility="Collapsed"/>

        <!-- ===== Bottom AppBar (collapsible) ===== -->
        <Grid Grid.Row="2" Height="24" x:Name="BottomBar">

            <!-- Expanded content (renders first = behind BarStrip) -->
            <Border Background="#2D2D2D" BorderBrush="#000000" BorderThickness="0,1,0,0" Padding="4,4,4,4" x:Name="BarContent" IsHitTestVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back -->
                    <Button Grid.Column="0" x:Name="BackButton" Style="{StaticResource BarButtonStyle}" ToolTipService.ToolTip="Back" IsEnabled="False">
                        <SymbolIcon Symbol="Back"/>
                    </Button>

                    <!-- Forward -->
                    <Button Grid.Column="1" x:Name="ForwardButton" Style="{StaticResource BarButtonStyle}" ToolTipService.ToolTip="Forward" IsEnabled="False" Margin="2,0,4,0">
                        <SymbolIcon Symbol="Forward"/>
                    </Button>

                    <!-- URL -->
                    <TextBox Grid.Column="2" x:Name="Omnibox" Style="{StaticResource BarOmniboxStyle}" 
			PlaceholderText="Search or enter URL" 
                        Margin="0,-8,0,-6"
                        VerticalAlignment="Center">
                        <TextBox.InputScope>
                            <InputScope>
                                <InputScope.Names>
                                    <InputScopeName NameValue="Url"/>
                                </InputScope.Names>
                            </InputScope>
                        </TextBox.InputScope>
                    </TextBox>

                    <!-- Menu (Hub) -->
                    <Button Grid.Column="3" x:Name="HubOpenButton" Style="{StaticResource BarButtonStyle}" ToolTipService.ToolTip="Menu" Margin="4,0,0,0">
                        <FontIcon Glyph="&#xE700;" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Collapsed strip — clickable handle (renders last = on top) -->
            <Border Height="12" VerticalAlignment="Top" Background="#2D2D2D" x:Name="BarStrip" IsHitTestVisible="True">
                <Border Height="3" Width="36" Background="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Border>
        </Grid>

        <!-- ===== Loading Overlay ===== -->
        <Grid x:Name="LoadingOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#AA000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing x:Name="LoadingRing" Width="48" Height="48" Foreground="White" IsActive="False" Margin="0,0,0,12"/>
                <TextBlock x:Name="OverlayStatusText" Text="Loading..." Foreground="White" FontSize="14" HorizontalAlignment="Center" Opacity="0.9"/>
            </StackPanel>
        </Grid>

        <!-- ===== Message Overlay ===== -->
        <Grid x:Name="MessageOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#CC202020" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                <SymbolIcon x:Name="MessageOverlayIcon" Symbol="Important" Foreground="#FF5555" Width="48" Height="48" Margin="0,0,0,16"/>
                <TextBlock x:Name="MessageOverlayTitle" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="MessageText" Foreground="#CCCCCC" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
                <Button x:Name="MessageClose" Content="Dismiss" Width="100" Background="#333333" BorderThickness="1" BorderBrush="#555555" Click="MessageClose_Click"/>
                <Button x:Name="ErrorRetryPoor" Content="Try in POOR mode" Width="140"
                        Background="#444444" BorderThickness="1" BorderBrush="#777777"
                        Margin="0,8,0,0" Click="ErrorRetryPoor_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- ===== Toast Notification ===== -->
        <Grid x:Name="ToastOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="ToastBar" Background="#DD323232" CornerRadius="8" Padding="16,10" Margin="12,12,12,60"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="400" Opacity="0">
                <TextBlock x:Name="ToastMessage" Foreground="White" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- ===== AI Hub (Dynamic Island) ===== -->
        <Grid x:Name="HubOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#E6000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Grid x:Name="HubPanel" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                  MaxHeight="520" Margin="0">
                <Border x:Name="HubBorder" Background="#2D2D2D" CornerRadius="16,16,0,0" Padding="0"
                        MaxWidth="500" HorizontalAlignment="Center" Width="480">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Hub Header (always visible) -->
                        <Border Grid.Row="0" Background="#353535" CornerRadius="16,16,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HubTitle" Text="AI Hub" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="HubBackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                        Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" Padding="8,4"
                                        Visibility="Collapsed" Click="HubBackButton_Click"/>
                                <Button Grid.Column="1" x:Name="HubCloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                        Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" Padding="8,4"
                                        Click="HubCloseButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Hub Content (swaps between views) -->
                        <Grid Grid.Row="1">
                            <!-- View 1: Main Menu -->
                            <StackPanel x:Name="HubMenuView" Visibility="Visible">
                                <Button x:Name="HubItemFavorites" Style="{StaticResource HubMenuItemStyle}" Click="HubItem_Click" Tag="Favorites">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFD700"/>
                                        <TextBlock Grid.Column="1" Text="Favorites" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="HubItemHistory" Style="{StaticResource HubMenuItemStyle}" Click="HubItem_Click" Tag="History">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#88CCFF"/>
                                        <TextBlock Grid.Column="1" Text="History" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Border Background="#444444" Height="1" Margin="16,4"/>
                                <Button x:Name="HubItemReading" Style="{StaticResource HubMenuItemStyle}" Click="HubItem_Click" Tag="Reading">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#AAFFAA"/>
                                        <TextBlock Grid.Column="1" Text="Reading Mode" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="HubItemAiSummary" Style="{StaticResource HubMenuItemStyle}" Click="HubItem_Click" Tag="AISummary">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#CCAAFF"/>
                                        <TextBlock Grid.Column="1" Text="AI Summary" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Border Background="#444444" Height="1" Margin="16,4"/>
                                <Button x:Name="HubItemScreenshot" Style="{StaticResource HubMenuItemStyle}" Click="HubItem_Click" Tag="Screenshot">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFCC88"/>
                                        <TextBlock Grid.Column="1" Text="Screenshot" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="HubItemCopyText" Style="{StaticResource HubMenuItemStyle}" Click="HubItem_Click" Tag="CopyText">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#CCCCCC"/>
                                        <TextBlock Grid.Column="1" Text="Copy Text" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Border Background="#444444" Height="1" Margin="16,4"/>
                                <Button x:Name="HubItemEbook" Style="{StaticResource HubMenuItemStyle}" Click="HubItem_Click" Tag="Ebook">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#88FFCC"/>
                                        <TextBlock Grid.Column="1" Text="E-book Mode" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HubEbookLabel" Grid.Column="2" Text="Rich" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="HubItemDevTools" Style="{StaticResource HubMenuItemStyle}" Click="HubItem_Click" Tag="DevTools">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF8888"/>
                                        <TextBlock Grid.Column="1" Text="DevTools" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="HubItemSettings" Style="{StaticResource HubMenuItemStyle}" Click="HubItem_Click" Tag="Settings">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Column="1" Text="Settings" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- View 2: Favorites sub-panel -->
                            <ScrollViewer x:Name="HubFavoritesView" Visibility="Collapsed" Padding="16,8">
                                <StackPanel x:Name="HubFavoritesList"/>
                            </ScrollViewer>

                            <!-- View 3: History sub-panel -->
                            <ScrollViewer x:Name="HubHistoryView" Visibility="Collapsed" Padding="16,8">
                                <StackPanel x:Name="HubHistoryList"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Reading Mode Overlay ===== -->
        <Grid x:Name="ReadingOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#F5F0E8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="#2D2D2D" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="ReaderFontMinus" Content="A−" FontSize="13" Width="36" Height="36" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Click="ReaderFontMinus_Click"/>
                    <TextBlock Grid.Column="1" Text="Reading Mode" Foreground="White" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="ReaderFontPlus" Content="A+" FontSize="15" Width="36" Height="36" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Margin="0,0,8,0" Click="ReaderFontPlus_Click"/>
                    <Button Grid.Column="3" x:Name="ReaderCloseButton" Content="✕" FontSize="14" Width="36" Height="36" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Click="ReaderCloseButton_Click"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" Margin="20,12,20,12">
                <TextBlock x:Name="ReaderContentText" TextWrapping="Wrap" FontSize="16" Foreground="#333333" LineHeight="28"/>
            </ScrollViewer>
        </Grid>

        <!-- ===== Status Bar ===== -->
        <Border x:Name="StatusBarBorder" Grid.Row="1" Background="#2D2D2D" VerticalAlignment="Bottom" Height="20" IsHitTestVisible="False">
            <TextBlock x:Name="StatusText" Foreground="#AAAAAA" FontSize="11" TextTrimming="CharacterEllipsis" Margin="8,2"/>
        </Border>
    </Grid>
</Page>
